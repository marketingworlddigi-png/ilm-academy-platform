# Copy to .env.local (never commit .env.local). No secrets belong in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-EDUCATION-PLATFORM-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Server-only. Leave unset unless a privileged server task needs it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Safety guard: the project ref the app/migrations are allowed to talk to. Must match the NEW education project.
EXPECTED_SUPABASE_PROJECT_REF=
